<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <radialGradient id="bakerGlow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#F2ECE1"/>
      <stop offset="60%" stop-color="#D4A359" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#221C16"/>
    </radialGradient>
  </defs>
  <rect width="100%" height="100%" fill="#221C16"/>
  <circle cx="400" cy="350" r="300" fill="url(#bakerGlow)"/>
  <!-- Chef Icon Graphic -->
  <g transform="translate(400, 320)">
    <circle cx="0" cy="-60" r="70" fill="#E5DAC7"/>
    <path d="M-90,140 C-90,30 -50,10 0,10 C50,10 90,30 90,140 Z" fill="#FFFFFF"/>
    <!-- Chef Hat -->
    <path d="M-60,-120 C-80,-180 -20,-200 0,-180 C20,-200 80,-180 60,-120 Z" fill="#FFFFFF"/>
    <!-- Sourdough Boule held on peel -->
    <circle cx="0" cy="110" r="55" fill="#B88536" stroke="#7A4B2A" stroke-width="6"/>
    <path d="M-30,95 Q0,130 30,95" stroke="#FFE8A3" stroke-width="8" fill="none"/>
  </g>
  <text x="400" y="620" text-anchor="middle" font-family="'Noto Sans JP', sans-serif" font-size="32" font-weight="bold" fill="#FFFFFF">日向 雅人 (Masato Hyuga)</text>
  <text x="400" y="670" text-anchor="middle" font-family="'Noto Sans JP', sans-serif" font-size="20" fill="#D4A359">代表シェフ・ブーランジェ / パリ修業10年</text>
</svg>
