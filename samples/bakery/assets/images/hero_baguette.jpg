<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" width="1920" height="1080">
  <defs>
    <radialGradient id="ovenGlow" cx="50%" cy="50%" r="60%">
      <stop offset="0%" stop-color="#FFD179" stop-opacity="0.9"/>
      <stop offset="50%" stop-color="#D4A359" stop-opacity="0.6"/>
      <stop offset="100%" stop-color="#3D2413" stop-opacity="0.95"/>
    </radialGradient>
    <linearGradient id="crustGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#E6BE7E"/>
      <stop offset="40%" stop-color="#D4A359"/>
      <stop offset="80%" stop-color="#7A4B2A"/>
      <stop offset="100%" stop-color="#3D2413"/>
    </linearGradient>
  </defs>
  <rect width="100%" height="100%" fill="#221C16"/>
  <circle cx="960" cy="540" r="700" fill="url(#ovenGlow)"/>
  <!-- Baguette Illustration -->
  <g transform="translate(960, 540) rotate(-15)">
    <ellipse cx="0" cy="0" rx="650" ry="120" fill="url(#crustGrad)"/>
    <!-- Coupes / Ear Cuts -->
    <path d="M-450,-40 Q-380,20 -320,-30" stroke="#FFE8A3" stroke-width="28" fill="none" stroke-linecap="round"/>
    <path d="M-220,-45 Q-150,25 -90,-35" stroke="#FFE8A3" stroke-width="32" fill="none" stroke-linecap="round"/>
    <path d="M10,-45 Q80,25 140,-35" stroke="#FFE8A3" stroke-width="32" fill="none" stroke-linecap="round"/>
    <path d="M240,-40 Q310,20 370,-30" stroke="#FFE8A3" stroke-width="28" fill="none" stroke-linecap="round"/>
    <ellipse cx="0" cy="0" rx="650" ry="120" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="6" stroke-dasharray="15,25"/>
  </g>
  <text x="960" y="880" text-anchor="middle" font-family="'Playfair Display', serif" font-size="64" font-weight="bold" fill="#F9F6F0" letter-spacing="4">BOULANGERIE ARTISANALE</text>
  <text x="960" y="940" text-anchor="middle" font-family="'Noto Sans JP', sans-serif" font-size="32" fill="#D4A359" letter-spacing="6">本場パリ伝統製法 薪石窯直焼き バゲット・トラディション</text>
</svg>
