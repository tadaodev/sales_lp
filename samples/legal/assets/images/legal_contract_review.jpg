<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 900" width="1200" height="900">
  <defs>
    <linearGradient id="deskBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1B140F"/>
      <stop offset="50%" stop-color="#2D1F17"/>
      <stop offset="100%" stop-color="#140D09"/>
    </linearGradient>
    <radialGradient id="lampGlow" cx="65%" cy="30%" r="65%">
      <stop offset="0%" stop-color="#FEF08A" stop-opacity="0.25"/>
      <stop offset="40%" stop-color="#F59E0B" stop-opacity="0.12"/>
      <stop offset="80%" stop-color="#000000" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="goldPenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFBEB"/>
      <stop offset="40%" stop-color="#D4AF37"/>
      <stop offset="70%" stop-color="#B45309"/>
      <stop offset="100%" stop-color="#78350F"/>
    </linearGradient>
    <linearGradient id="suitSleeveGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1E3A5F"/>
      <stop offset="50%" stop-color="#0A192F"/>
      <stop offset="100%" stop-color="#050B14"/>
    </linearGradient>
    <filter id="macroBlur">
      <feGaussianBlur stdDeviation="10"/>
    </filter>
  </defs>

  <!-- Polished Mahogany Desk Background -->
  <rect width="1200" height="900" fill="url(#deskBg)"/>
  <!-- Warm Desk Lamp Ambient Light -->
  <rect width="1200" height="900" fill="url(#lampGlow)"/>

  <!-- Background Desk Accessories (Out of Focus Depth-of-field) -->
  <g opacity="0.4" filter="url(#macroBlur)">
    <!-- Leather Bound Notebook -->
    <rect x="680" y="80" width="340" height="200" rx="8" fill="#451A03" stroke="#291102" stroke-width="3"/>
    <!-- Crystal Water Tumbler -->
    <ellipse cx="880" cy="180" rx="35" ry="18" fill="#E2E8F0" opacity="0.6"/>
    <path d="M845,180 L855,270 Q880,285 905,270 L915,180 Z" fill="#94A3B8" opacity="0.3"/>
  </g>

  <!-- iPad Pro (Legal Risk Analytics Dashboard) -->
  <g transform="translate(80, 120) rotate(-6)">
    <!-- Tablet Body -->
    <rect x="0" y="0" width="460" height="320" rx="16" fill="#0F172A" stroke="#334155" stroke-width="4"/>
    <rect x="12" y="12" width="436" height="296" rx="8" fill="#0B132B"/>
    <!-- UI Header -->
    <rect x="25" y="25" width="120" height="12" rx="3" fill="#D4AF37"/>
    <text x="25" y="55" font-family="'Noto Sans JP', sans-serif" font-size="13" font-weight="700" fill="#FFFFFF">契約書リスク事前スキャン結果</text>
    <rect x="25" y="68" width="80" height="18" rx="4" fill="#059669"/>
    <text x="32" y="81" font-family="'Noto Sans JP', sans-serif" font-size="10" font-weight="700" fill="#FFFFFF">重大リスク 0件</text>
    <rect x="115" y="68" width="90" height="18" rx="4" fill="#D97706"/>
    <text x="122" y="81" font-family="'Noto Sans JP', sans-serif" font-size="10" font-weight="700" fill="#FFFFFF">要修正条項 2件</text>

    <!-- Analytics Chart -->
    <path d="M40,240 L120,200 L200,220 L280,160 L360,130 L410,140" fill="none" stroke="#D4AF37" stroke-width="3"/>
    <polygon points="40,240 120,200 200,220 280,160 360,130 410,140 410,260 40,260" fill="#D4AF37" opacity="0.1"/>
    <circle cx="360" cy="130" r="5" fill="#FDE047"/>
    <circle cx="280" cy="160" r="5" fill="#FDE047"/>
  </g>

  <!-- Legal Contract Documents on Desk (Sharp Focus) -->
  <g transform="translate(380, 260) rotate(-2)">
    <!-- Document Stack Shadows -->
    <rect x="10" y="10" width="540" height="580" rx="4" fill="#000000" opacity="0.35"/>
    <rect x="5" y="5" width="540" height="580" rx="4" fill="#F1F5F9" opacity="0.9"/>
    <!-- Top Active Sheet -->
    <rect x="0" y="0" width="540" height="580" rx="4" fill="#FCFCFD" stroke="#E2E8F0" stroke-width="1.5"/>

    <!-- Document Header -->
    <text x="270" y="55" font-family="'Shippori Mincho', serif" font-size="22" font-weight="700" fill="#1E293B" text-anchor="middle" letter-spacing="4">業務委託基本契約書（修正案）</text>
    <line x1="80" y1="72" x2="460" y2="72" stroke="#CBD5E1" stroke-width="1.5"/>

    <!-- Contract Clauses -->
    <g fill="#475569" font-family="'Noto Sans JP', sans-serif" font-size="11">
      <text x="50" y="105" font-weight="700" fill="#0F172A">第12条（損害賠償責任の範囲及び上限）</text>
      <rect x="50" y="118" width="440" height="6" rx="2" fill="#94A3B8" opacity="0.5"/>
      <rect x="50" y="132" width="410" height="6" rx="2" fill="#94A3B8" opacity="0.5"/>
      <!-- Legal Annotation Highlight (Yellow/Gold Highlight Bar) -->
      <rect x="46" y="145" width="448" height="24" rx="3" fill="#FEF08A" opacity="0.55"/>
      <text x="50" y="161" font-weight="700" fill="#B45309">★ 甲の故意又は重過失による場合を除き、受託金額を上限とする【修正済】</text>

      <text x="50" y="200" font-weight="700" fill="#0F172A">第18条（秘密保持義務及び機密情報の保護）</text>
      <rect x="50" y="213" width="440" height="6" rx="2" fill="#94A3B8" opacity="0.5"/>
      <rect x="50" y="227" width="380" height="6" rx="2" fill="#94A3B8" opacity="0.5"/>
      <rect x="50" y="241" width="420" height="6" rx="2" fill="#94A3B8" opacity="0.5"/>

      <text x="50" y="275" font-weight="700" fill="#0F172A">第24条（知的財産権の帰属及び二次利用）</text>
      <rect x="50" y="288" width="440" height="6" rx="2" fill="#94A3B8" opacity="0.5"/>
      <rect x="50" y="302" width="390" height="6" rx="2" fill="#94A3B8" opacity="0.5"/>

      <!-- Checkmarks -->
      <path d="M470,100 L478,108 L495,92" stroke="#16A34A" stroke-width="3" fill="none"/>
      <path d="M470,195 L478,203 L495,187" stroke="#16A34A" stroke-width="3" fill="none"/>
      <path d="M470,270 L478,278 L495,262" stroke="#16A34A" stroke-width="3" fill="none"/>
    </g>

    <!-- Japanese Legal Hanko Verification Stamp (Red Seal) -->
    <g transform="translate(130, 480)">
      <circle cx="0" cy="0" r="34" fill="#DC2626" opacity="0.88"/>
      <circle cx="0" cy="0" r="30" fill="none" stroke="#FFFFFF" stroke-width="2.5"/>
      <!-- Seal Kanji Characters -->
      <text x="0" y="-8" font-family="'Shippori Mincho', serif" font-size="14" font-weight="700" fill="#FFFFFF" text-anchor="middle">ルーメン</text>
      <text x="0" y="14" font-family="'Shippori Mincho', serif" font-size="14" font-weight="700" fill="#FFFFFF" text-anchor="middle">法律事務所</text>
    </g>
  </g>

  <!-- Traditional Hanko Seal Stamp Stand (Wood & Vermilion Inkpad) -->
  <g transform="translate(220, 720)">
    <!-- Inkpad Vermilion Container -->
    <ellipse cx="0" cy="20" rx="60" ry="24" fill="#451A03"/>
    <ellipse cx="0" cy="16" rx="52" ry="19" fill="#B91C1C"/>
    <ellipse cx="0" cy="16" rx="44" ry="15" fill="#DC2626"/>
    <!-- Solid Wood Hanko Stamp -->
    <path d="M-16,-50 L16,-50 L22,10 L-22,10 Z" fill="#78350F" stroke="#451A03" stroke-width="2"/>
    <ellipse cx="0" cy="-50" rx="16" ry="6" fill="#A16207"/>
  </g>

  <!-- Attorney's Right Hand & Luxury Gold Fountain Pen (Foreground Macro) -->
  <g transform="translate(780, 520)">
    <!-- Dark Navy Wool Suit Sleeve with French Cuff -->
    <path d="M120,-80 L380,240 L280,360 L20,-10 Z" fill="url(#suitSleeveGrad)" stroke="#1E293B" stroke-width="2"/>
    <!-- Crisp White Shirt Cuff -->
    <polygon points="120,-80 80,-40 10,20 20,-10" fill="#FFFFFF"/>
    <!-- Gold Cufflink -->
    <circle cx="70" cy="-20" r="7" fill="url(#goldPenGrad)"/>

    <!-- Hand & Fingers Gripping Pen -->
    <!-- Palm & Knuckles -->
    <path d="M60,-20 Q-40,20 -70,90 Q-60,160 0,180 Q80,180 120,80 Z" fill="#DEBA94"/>
    <!-- Thumb -->
    <path d="M-20,40 Q-80,60 -110,100 Q-90,130 -50,110 Q-10,90 20,60 Z" fill="#E8CBB0"/>
    <!-- Index Finger -->
    <path d="M-60,95 Q-140,120 -180,170 Q-160,195 -120,180 Q-70,160 -30,130 Z" fill="#ECCBB0"/>
    <!-- Gold Wedding Band / Signet Ring -->
    <ellipse cx="-85" cy="115" rx="9" ry="14" fill="url(#goldPenGrad)" transform="rotate(30 -85 115)"/>

    <!-- Montblanc Meisterstück Style Luxury Gold Fountain Pen -->
    <g transform="translate(-140, 160) rotate(-38)">
      <!-- Pen Body (Glossy Black Resin) -->
      <rect x="0" y="-12" width="220" height="24" rx="6" fill="#09090B"/>
      <!-- Gold Rings & Trim -->
      <rect x="25" y="-13" width="10" height="26" fill="url(#goldPenGrad)"/>
      <rect x="40" y="-13" width="5" height="26" fill="url(#goldPenGrad)"/>
      <rect x="180" y="-13" width="14" height="26" fill="url(#goldPenGrad)"/>
      <!-- Gold Nib Section -->
      <polygon points="0,-10 -35,-4 -45,0 -35,4 0,10" fill="url(#goldPenGrad)"/>
      <!-- Nib Breathing Hole & Slit -->
      <circle cx="-25" cy="0" r="2" fill="#1C1917"/>
      <line x1="-45" y1="0" x2="-25" y2="0" stroke="#1C1917" stroke-width="0.8"/>
    </g>
  </g>

  <!-- Champagne Gold Frame / Glassmorphism Badge -->
  <g transform="translate(60, 780)">
    <rect x="0" y="0" width="380" height="64" rx="10" fill="#0A192F" fill-opacity="0.88" stroke="#D4AF37" stroke-width="1.5"/>
    <text x="25" y="28" font-family="'Shippori Mincho', serif" font-size="16" font-weight="700" fill="#FFFFFF">【強み01】最短即日 予防法務レビュー</text>
    <text x="25" y="48" font-family="'Noto Sans JP', sans-serif" font-size="12" fill="#D4AF37">不利条項・損害賠償リスクを事前に徹底遮断</text>
  </g>
</svg>
